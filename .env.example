# Chiavi server. Su Vercel sono già impostate.
# next.config le espone al browser come NEXT_PUBLIC_SUPABASE_URL
# e NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY. La chiave publishable può stare nel client.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Collector, solo server. Vedi docs/collector.md.
# CRON_SECRET non è ancora su Vercel: crealo e usalo come LNPUSH_TOKEN nello script locale.
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Opzionale. Senza questa chiave il pulsante Collect all resta nascosto.
BRAVE_SEARCH_API_KEY=
